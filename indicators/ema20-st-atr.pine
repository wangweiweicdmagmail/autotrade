//@version=6
indicator("EMA20 回踩 · SuperTrend + ATR", shorttitle="EMA20-ST-ATR", overlay=true)

emaLength = input.int(20, "EMA 周期", minval=1, group="回踩")
stLength = input.int(10, "超级趋势周期", minval=1, group="方向")
stFactor = input.float(3.0, "超级趋势倍数", minval=0.1, step=0.1, group="方向")
atrLength = input.int(14, "ATR 周期", minval=1, group="止损")
atrFactor = input.float(1.2, "ATR 倍数", minval=0.1, step=0.1, group="止损")

emaLine = ta.ema(close, emaLength)
atrValue = ta.atr(atrLength)
[supertrend, trend] = ta.supertrend(stFactor, stLength)
int direction = na(supertrend) or na(trend) ? 0 : trend < 0 ? 1 : trend > 0 ? -1 : 0

entryPrice = math.round_to_mintick(emaLine)
longStop = math.round_to_mintick(emaLine - atrValue * atrFactor)
shortStop = math.round_to_mintick(emaLine + atrValue * atrFactor)
priceReady = not na(entryPrice) and entryPrice > 0
atrReady = not na(atrValue) and atrValue > 0
validLong = priceReady and atrReady and not na(longStop) and longStop > 0 and longStop < entryPrice
validShort = priceReady and atrReady and not na(shortStop) and shortStop > entryPrice

// 与 EMA9 模板同口径：实时 K 线的高低区间覆盖均线即为触线。
touched = priceReady and low <= entryPrice and high >= entryPrice
longSignal = direction == 1 and validLong and touched
shortSignal = direction == -1 and validShort and touched

plot(longSignal or shortSignal ? 1 : 0, "Entry_Signal", display=display.data_window, offset=0)
plot(direction, "Direction", display=display.data_window, offset=0)
plot(priceReady ? entryPrice : na, "Entry_Price", display=display.data_window, offset=0)
plot(direction == 1 and validLong ? longStop : na, "Long_Stop", display=display.data_window, offset=0)
plot(direction == -1 and validShort ? shortStop : na, "Short_Stop", display=display.data_window, offset=0)
plot(atrValue, "ATR", display=display.data_window, offset=0)

plot(entryPrice, "EMA 回踩线", color=color.orange, linewidth=2)
plot(direction == 1 and validLong ? longStop : na, "多头保护线", color=color.green, style=plot.style_linebr)
plot(direction == -1 and validShort ? shortStop : na, "空头保护线", color=color.red, style=plot.style_linebr)
plotshape(longSignal, "多头触线", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(shortSignal, "空头触线", shape.triangledown, location.abovebar, color.red, size=size.tiny)
