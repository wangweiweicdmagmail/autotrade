//@version=6
indicator("TD 序列分时线", shorttitle="TD Price Line", overlay=true, format=format.price, explicit_plot_zorder=true)

// 独立观察指标：借用 TD Setup 的 close 与 close[4] 比较思路。
// 使用带正负号的连续计数，不包含完整 TD Sequential 的 9/13 及衰竭规则。
comparisonBars = input.int(4, "比较前几根收盘价", minval=1)
trendThreshold = input.int(3, "趋势着色阈值", minval=1)
lineWidth = input.int(3, "折线宽度", minval=1, maxval=5)
upColor = input.color(color.rgb(34, 197, 94), "上涨颜色")
downColor = input.color(color.rgb(242, 54, 69), "下跌颜色")
rangeColor = input.color(color.rgb(145, 145, 145), "震荡颜色")
formingColor = input.color(color.rgb(241, 196, 15), "未收盘颜色")

if not timeframe.isminutes or timeframe.multiplier != 1
    runtime.error("请切换到 1 分钟图表后查看 TD 序列分时线")

// 始终从上一根 K 线的计数计算；同一分钟内多次报价不会重复累加。
// 比较相等或缺少历史时归零，反向满足时从 +1 / -1 重新开始。
// 连续方向超过 9 后仍继续计数，不在第 9 根后强制回到灰色。
var int tdCount = 0
int previousCount = nz(tdCount[1], 0)
if barstate.isconfirmed
    if na(close) or na(close[comparisonBars])
        tdCount := 0
    else if close > close[comparisonBars]
        tdCount := previousCount > 0 ? previousCount + 1 : 1
    else if close < close[comparisonBars]
        tdCount := previousCount < 0 ? previousCount - 1 : -1
    else
        tdCount := 0

int direction = tdCount >= trendThreshold ? 1 : tdCount <= -trendThreshold ? -1 : 0
color priceColor = direction == 1 ? upColor : direction == -1 ? downColor : rangeColor

// 仅已收盘的线段使用 TD 颜色；未收盘不计算预估 TD。
// 形成中的最后一段统一黄色虚线，空心端点仅跟随实际最新报价。
bool forming = barstate.islast and not barstate.isconfirmed
plot(barstate.isconfirmed ? close : na, "TD_Price", color=priceColor, linewidth=lineWidth, style=plot.style_linebr, offset=0)
plot(close, "Forming_Line", color=forming ? formingColor : na, linewidth=lineWidth, style=plot.style_linebr, show_last=2, linestyle=plot.linestyle_dashed, display=display.pane, offset=0)
plot(forming ? close : na, "Forming_Price", color=formingColor, linewidth=lineWidth+2, style=plot.style_circles, display=display.pane, offset=0)
plot(forming ? close : na, "Forming_Point_Inner", color=chart.bg_color, linewidth=lineWidth, style=plot.style_circles, display=display.pane, offset=0)
plot(tdCount, "TD_Count", display=display.data_window, offset=0)
plot(tdCount, "TD_Count_Confirmed", display=display.data_window, offset=0)

// 保留公共输出接口；当前仅用于观察，未定义入场或止损，不产生交易信号。
plot(0, "Entry_Signal", display=display.data_window, offset=0)
plot(direction, "Direction", display=display.data_window, offset=0)
plot(float(na), "Entry_Price", display=display.data_window, offset=0)
plot(float(na), "Long_Stop", display=display.data_window, offset=0)
plot(float(na), "Short_Stop", display=display.data_window, offset=0)
plot(float(na), "ATR", display=display.data_window, offset=0)
