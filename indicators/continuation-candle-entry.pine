//@version=6
indicator("连续趋势 K 线入场", shorttitle="趋势 K 线入场", overlay=true)

minStreak = input.int(2, "连续同向 K 线根数（含信号 K 线）", minval=2)
atrLength = input.int(14, "ATR 周期", minval=1)
minBodyAtr = input.float(1.0, "信号实体最小 ATR 倍数", minval=0.1, step=0.1)
retracement = input.float(0.38, "从极值回撤比例", minval=0.01, maxval=0.99, step=0.01)

atr = ta.atr(atrLength)
var int upStreak = 0
var int downStreak = 0
upStreak := close > open ? nz(upStreak[1]) + 1 : 0
downStreak := close < open ? nz(downStreak[1]) + 1 : 0

// 信号 K 线要先收盘。实体与其前一根已收盘 ATR 比较，避免把信号本身计入基准。
int direction = upStreak[1] >= minStreak ? 1 : downStreak[1] >= minStreak ? -1 : 0
body = math.abs(close[1] - open[1])
baseline = atr[2]
setup = direction != 0 and baseline > 0 and body >= minBodyAtr * baseline

// 信号价位只在其下一根 K 线有效，整根内保持固定。
stopPrice = math.round_to_mintick(direction == 1 ? low[1] : open[1])
float entryPrice = na
if setup and direction == 1
    entryPrice := math.round_to_mintick(high[1] - (high[1] - open[1]) * retracement)
if setup and direction == -1
    entryPrice := math.round_to_mintick(low[1] + (open[1] - low[1]) * retracement)

validLong = setup and direction == 1 and stopPrice > 0 and entryPrice > stopPrice
validShort = setup and direction == -1 and entryPrice > 0 and stopPrice > entryPrice
// 从趋势一侧向入场价回撤才触发。触及止损后，当根计划失效。
longSignal = validLong and open >= entryPrice and low <= entryPrice and low > stopPrice
shortSignal = validShort and open <= entryPrice and high >= entryPrice and high < stopPrice

plot(longSignal or shortSignal ? 1 : 0, "Entry_Signal", display=display.data_window, offset=0)
plot(direction, "Direction", display=display.data_window, offset=0)
plot(validLong or validShort ? entryPrice : na, "Entry_Price", display=display.data_window, offset=0)
plot(validLong ? stopPrice : na, "Long_Stop", display=display.data_window, offset=0)
plot(validShort ? stopPrice : na, "Short_Stop", display=display.data_window, offset=0)
plot(baseline, "ATR", display=display.data_window, offset=0)

// 圆点标出每根 K 线的计划价，避免把不同信号的价位连成同一段。
plot(validLong or validShort ? entryPrice : na, "入场参考价", color=color.aqua, linewidth=2, style=plot.style_circles)
plot(validLong or validShort ? stopPrice : na, "初始止损价", color=color.orange, linewidth=2, style=plot.style_circles)
plotshape(longSignal, "多头触发", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(shortSignal, "空头触发", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
