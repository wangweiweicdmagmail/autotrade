//@version=6
indicator("ema7_autotrade_v2", shorttitle="EMA7 Auto v2", overlay=true)

stPeriod = input.int(10, "超级趋势周期", minval=1, group="方向")
stMultiplier = input.float(3.0, "超级趋势倍数", minval=0.1, step=0.1, group="方向")
atrLength = input.int(14, "ATR 周期", minval=1, group="保护止损")
stopMultiplier = input.float(1.2, "止损 ATR 倍数", minval=0.1, step=0.1, group="保护止损")
offsetMultiplier = input.float(0.2, "预测偏移 ATR 倍数", minval=0, step=0.05, group="触线")
toleranceTicks = input.int(1, "触线后允许偏离的最小跳动数", minval=0, group="触线")

ema7 = ta.ema(close, 7)
confirmedAtr = ta.atr(atrLength)[1]
[supertrend, stDirection] = ta.supertrend(stMultiplier, stPeriod)
int direction = na(supertrend) or na(stDirection) ? 0 : stDirection < 0 ? 1 : -1

// 三段速度取平均。预测线、修正线和保护参考线全部只用已收盘数据。
velocity = (ema7[1] - ema7[4]) / 3.0
forecast = ema7[1] + velocity
entryPrice = math.round_to_mintick(forecast + math.sign(velocity) * offsetMultiplier * confirmedAtr)
longStop = math.round_to_mintick(entryPrice - stopMultiplier * confirmedAtr)
shortStop = math.round_to_mintick(entryPrice + stopMultiplier * confirmedAtr)
ready = not na(entryPrice) and entryPrice > 0 and not na(confirmedAtr) and confirmedAtr > 0
validLong = ready and longStop > 0 and longStop < entryPrice
validShort = ready and shortStop > entryPrice

// 固定触线价在本根开盘即已知。开盘价判定来向，根内极值记录曾触达。
// 实时 close 离开容差后撤掉信号；历史 close 只能代表本根最终状态。
longTouch = validLong and direction == 1 and velocity > 0 and open > entryPrice and low <= entryPrice
shortTouch = validShort and direction == -1 and velocity < 0 and open < entryPrice and high >= entryPrice
nearLine = ready and math.abs(close - entryPrice) <= toleranceTicks * syminfo.mintick + syminfo.mintick * 1e-6
longSignal = longTouch and nearLine and close > longStop
shortSignal = shortTouch and nearLine and close < shortStop

plot(longSignal or shortSignal ? 1 : 0, "Entry_Signal", display=display.data_window, offset=0)
plot(direction, "Direction", display=display.data_window, offset=0)
plot(ready ? entryPrice : na, "Entry_Price", display=display.data_window, offset=0)
plot(direction == 1 and validLong ? longStop : na, "Long_Stop", display=display.data_window, offset=0)
plot(direction == -1 and validShort ? shortStop : na, "Short_Stop", display=display.data_window, offset=0)
plot(confirmedAtr, "ATR", display=display.data_window, offset=0)
plot(longTouch or shortTouch ? 1 : 0, "Forecast_Touched", display=display.data_window, offset=0)
plot(ema7, "实际 EMA7", color=color.orange)
plot(forecast, "预测重心", color=color.aqua, style=plot.style_stepline)
plot(entryPrice, "修正触线价", color=color.fuchsia, linewidth=2, style=plot.style_stepline)
plotshape(longTouch ? entryPrice : na, "多头曾触线", style=shape.triangleup, location=location.absolute, color=color.lime, size=size.tiny)
plotshape(shortTouch ? entryPrice : na, "空头曾触线", style=shape.triangledown, location=location.absolute, color=color.red, size=size.tiny)
