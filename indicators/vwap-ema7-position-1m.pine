//@version=6
indicator("1M ETH VWAP · EMA7 位置与速度", overlay=true)

bandMultiplier = input.float(1.0, "VWAP 标准差倍数", minval=0.1, step=0.1)
if not timeframe.isminutes or timeframe.multiplier != 1
    runtime.error("请使用 1 分钟图表")

// 指标需与控制台使用同一盘前盘后时段；标准EMA/ST跨日连续计算。
et = "America/New_York"
inSession = not na(time("1", "0400-2000:23456", et))
regular = not na(time("1", "0930-1600:23456", et))
newSession = timeframe.change("D") or barstate.isfirst
[sessionVwap, rawUpper, rawLower] = ta.vwap(hlc3, newSession, bandMultiplier)
var int positiveSamples = 0
positiveSamples := newSession ? (volume > 0 ? 1 : 0) : nz(positiveSamples[1], 0) + (volume > 0 ? 1 : 0)
ema = ta.ema(close, 7)
[_, stDirection] = ta.supertrend(4.0, 10)
center = inSession ? sessionVwap : na
halfWidth = inSession and not na(center) ? (positiveSamples >= 2 ? math.max(0.0, rawUpper - center) : 0.0) : na
upper = center + halfWidth
lower = center - halfWidth
position = halfWidth > 0 ? (ema - center) / halfWidth : na
zone = na(position) ? na : position > 1 ? 1 : position < -1 ? -1 : 0
// 七分钟比较使用实际时刻，可在09:30跨过开盘边界，不跨隔夜空档。
speed = inSession and inSession[7] and time - time[7] == 420000 ? ema - ema[7] : na

plot(center, "VWAP", color=color.orange, style=plot.style_linebr)
plot(upper, "VWAP_Upper", color=color.green, style=plot.style_linebr)
plot(lower, "VWAP_Lower", color=color.red, style=plot.style_linebr)
plot(inSession ? ema : na, "EMA7_Close", color=color.aqua, style=plot.style_linebr)
plot(position, "VWAP_Position", display=display.data_window)
plot(zone, "VWAP_Zone", display=display.data_window)
plot(speed, "EMA7_Speed_7m", display=display.data_window)
plot(regular ? 1 : 0, "RTH_Active", display=display.data_window)
plot(not na(speed) ? ema[7] : na, "EMA7_7m_Ago", display=display.data_window)
atrReady = not na(ta.atr(10))
plot(inSession and atrReady ? -stDirection : na, "ST_Direction", display=display.data_window)
