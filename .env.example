# 交易 Agent LLM 配置（复制为 .env 并填入 key；.env 已 gitignore，禁止提交）
# Kimi（Moonshot）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.7-code
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# 后端选择：deepseek（主力，成本可忽略）/ kimi（对照）
LLM_BACKEND=deepseek
# 交易 Agent 总开关：1 = 启用（默认 0 关闭；EXECUTION_ENABLED=0 时全部 dry-run 虚拟成交）
AGENT_ENABLED=0
