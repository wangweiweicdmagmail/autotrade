{
  "manifest_version": 3,
  "name": "AutoTrade TradingView 联动",
  "version": "0.8.0",
  "minimum_chrome_version": "102",
  "permissions": [
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.tradingview.com/*",
    "https://cn.tradingview.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "presence.json"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
